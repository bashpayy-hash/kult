# Postgres connection string. On Netlify leave it unset: Netlify Database
# provides NETLIFY_DB_URL itself. Locally: your own Postgres. On another host:
# e.g. Supabase → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shaqyru

# Uploads (venue photos and logos, story screenshots).
# Netlify: STORAGE_BACKEND=blobs (Netlify Blobs). Local `next start`: STORAGE_LOCAL=1.
# Or Supabase Storage: Project URL and the service_role key (server only, never NEXT_PUBLIC_).
STORAGE_BACKEND=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin password for /admin, and a long random string that signs the admin cookie
# and salts visitor hashes. Generate: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=

# Public address of the site, used to build member links and hostess links.
NEXT_PUBLIC_SITE_URL=https://shaqyru-7ol3.netlify.app

# Pilot success threshold: guests per member visit.
PILOT_THRESHOLD=2
